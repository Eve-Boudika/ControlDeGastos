@model ControlDeGastos.ViewModels.GastosResumenViewModel
@{
    ViewBag.Title = "Filtrar gastos por categoría";
    var meses = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames;
}

<h2>Filtrar gastos por categoría</h2>



@using (Html.BeginForm("FiltrarPorCategoria", "Gastos", FormMethod.Get))
{
    <label>Categoría:</label>
    <select name="categoriaId" class="form-control" style="width: 150px; display: inline-block;">
        <option value="">Todas</option>
        @foreach (var categoria in Model.Categorias)
        {
            <option value="@categoria.Id" @(categoria.Id == Model.CategoriaSeleccionadaId ? "selected" : "")>
                @categoria.Nombre
            </option>
        }
    </select>

    <label>Mes:</label>
    <select name="mes" class="form-control" style="width: 150px; display: inline-block;">
        @for (int i = 1; i <= 12; i++)
        {
            <option value="@i" @(i == Model.Periodo.Month ? "selected" : "")>@meses[i - 1]</option>
        }
    </select>

    <label>Año:</label>
    <input type="number" name="anio" value="@Model.Periodo.Year" class="form-control" style="width: 100px; display: inline-block;" />

    <input type="submit" value="Filtrar" class="btn btn-primary" />
}

@if (Model.Gastos.Any())
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Detalle</th>
                <th>Monto</th>
                @*<th>Categoría</th>*@
            </tr>
        </thead>
        <tbody>
            @foreach (var g in Model.Gastos)
            {
                <tr>
                    <td>@g.Fecha.ToShortDateString()</td>
                    <td>@g.Detalle</td>
                    <td>$@g.Monto</td>
                    @*<td>@g.Categoria.Nombre</td>*@
                </tr>
            }
        </tbody>
    </table>

    <p><strong>Total gastado:</strong> $@Model.TotalGastado</p>
}
else
{
    if (Model.CategoriaSeleccionadaId.HasValue)
    {
        var categoria = Model.Categorias.FirstOrDefault(c => c.Id == Model.CategoriaSeleccionadaId.Value);
        <p class="alert alert-warning">No hay gastos registrados para esa categoría </p>
    }
    else
    {
        <p class="alert alert-info">No hay gastos registrados.</p>
    }
}

<p>
    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-primary" })
</p>