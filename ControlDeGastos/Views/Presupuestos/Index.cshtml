@model IEnumerable<ControlDeGastos.Models.Presupuesto>

@{
    ViewBag.Title = "Index";
}

<h2>Listado de Presupuestos</h2>

<p>
    @Html.ActionLink("Agregar nuevo presupuesto", "Create", null, new { @class = "btn btn-success" })
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Año)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Mes)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Monto)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Año.Year)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Mes.Month)
        </td>
        <td>
            $@Html.DisplayFor(modelItem => item.Monto)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.Id }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.Id })
        </td>
    </tr>
}

</table>
